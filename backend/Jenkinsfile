
pipeline {
    agent any

    stages {
        stage('Deploy Flask') {
            steps {
                echo 'Starting Flask deployment...'

                sh 'sudo -u ubuntu /usr/local/bin/deploy-flask'
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'sudo -u ubuntu /usr/bin/pm2 list'
                echo 'Flask deployment completed!'
            }
        }
    }

    post {
        success {
            echo 'Flask deployment successful!'
        }

        failure {
            echo 'Flask deployment failed!'
        }
    }
}
